    },
    "FundType": {
      "type": "string",
      "rules": {
        "CASH_BUY": "required",
        "CASH_SELL": "two_halfwidth_spaces",
        "MARGIN_NEW": "optional; '11' or omit (auto-set to '11')",
        "MARGIN_REPAY": "optional; '11' or omit (auto-set to '11')"
      },
      "enum_known": {"  ": "CASH_SELL", "02": "PROTECTED", "AA": "MARGIN_SUBSTITUTE", "11": "MARGIN"}
    },
    "AccountType": {
      "type": "integer",
      "required": true,
