        "23": "LOC_AM",
        "24": "LOC_PM",
        "25": "FUNARI_AM",
        "26": "FUNARI_PM",
        "27": "IOC_LIMIT",
        "30": "REVERSE_LIMIT"
      }
    },
    "Price": {
      "type": "number",
      "required": true,
      "rules": {
        "MARKET_family": "must be 0",
        "LIMIT_family": "must be order price > 0",
        "REVERSE_LIMIT": "omit / use AfterHitPrice (NOT_IMPLEMENTED)"
      }
    },
    "ExpireDay": {
      "type": "integer",
      "required": true,
      "notes": "yyyyMMdd or 0 (= kabuStation 'today' / next tradable day semantics)"
    },
    "ReverseLimitOrder": {
      "type": "object",
      "required_when": "FrontOrderType=30",
