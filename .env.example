# tradebotfile/.env.example
# このファイルを .env にコピーして値を設定してください。
#
# 重要:
# - このプロジェクトでは「プロジェクト直下の .env」のみを読み込みます。
# - 親フォルダ探索はしません（discord_issue_bot 等の .env を参照しません）。
#
# Discord (Bot送信)
DISCORD_BOT_TOKEN=
ALERT_CHANNEL_ID=
PAPER_ALERT_CHANNEL_ID=
PAPER_LOG_CHANNEL_ID=
#
# (任意) Webhook送信を使う場合
DISCORD_WEBHOOK_URL=

