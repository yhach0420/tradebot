# tradebotfile/.env.example
# このファイルを .env にコピーして値を設定してください。
#
# 重要:
# - このプロジェクトでは「プロジェクト直下の .env」のみを読み込みます。
# - 親フォルダ探索はしません（discord_issue_bot 等の .env を参照しません）。
#
# Discord (Bot送信)
DISCORD_BOT_TOKEN=
ALERT_CHANNEL_ID=
PAPER_ALERT_CHANNEL_ID=
PAPER_LOG_CHANNEL_ID=
#
# (任意) Webhook送信を使う場合
DISCORD_WEBHOOK_URL=

#
# kabuステーション® API（Kabuステーション本体でAPI受付を有効にしたうえで設定）
# ※ソースに直書きせず、この .env にのみ設定してください。
KABU_API_PASSWORD=
# (任意) 省略時は本番用 http://localhost:18080/kabusapi（検証は 18081）
# KABU_API_BASE=http://localhost:18080/kabusapi
#
# (任意) paper_trade の現値ソース: yahoo（既定） / kabu（kabu 不可時は自動で Yahoo）
# MARKET_DATA_PROVIDER=yahoo
#
# (任意) paper_trade ポールと並行して kabu_signal_v1 を評価しログ保存（ENTRY/Discord なし）
# KABU_SIGNAL_SHADOW=1
# KABU_SIGNAL_SHADOW_TIER=B
