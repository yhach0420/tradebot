# discord_issue_bot/.env.example
# このファイルを .env にコピーして値を設定してください。
#
# 重要:
# - このサブプロジェクトでは「discord_issue_bot/ 直下の .env」のみを読み込みます。
# - 親フォルダ探索はしません（tradebotfile/.env を参照しません）。
#
# Discord bot token
DISCORD_TOKEN=
# (old compat; optional)
DISCORD_BOT_TOKEN=
#
# GitHub token（Issue作成権限）
GITHUB_TOKEN=
#
# 通知先（どちらかは必要）
DISCORD_WEBHOOK_URL=
ALERT_CHANNEL_ID=
#
# コマンド受付チャンネル（任意。!issue / !core / !watch）
# !budget は未設定だと fail closed
CONTROL_CHANNEL_ID=
#
# !budget show / !budget set を許可する Discord user ID。
# カンマ区切り。未設定・空・不正なら資本コマンドは拒否する。
# 例: CAPITAL_CONTROL_USER_IDS=123456789012345678
CAPITAL_CONTROL_USER_IDS=

